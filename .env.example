# omnichannel_backend — environment template
# Copy to .env and fill in real values. .env is gitignored; this file is not,
# so never put real secrets here.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
# Allowed browser origin(s) for CORS. Defaults to "*" if unset.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# PostgreSQL (Neon)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Encrypts per-user secrets (e.g. FreePBX extension passwords) at rest.
# 64 hex chars = 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Chatwoot Platform API
# ---------------------------------------------------------------------------
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_PLATFORM_TOKEN=

# ---------------------------------------------------------------------------
# Keycloak Admin API
# ---------------------------------------------------------------------------
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=omnichannel
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# FreePBX — GraphQL API (extension provisioning, CDR)
# ---------------------------------------------------------------------------
# OAuth2 client-credentials app created under FreePBX -> Connectivity -> API,
# with the "gql" scope.
FREEPBX_GQL_URL=https://pbx.example.com/admin/api/api/gql
FREEPBX_TOKEN_URL=https://pbx.example.com/admin/api/api/token
FREEPBX_CLIENT_ID=
FREEPBX_CLIENT_SECRET=
# First extension number to allocate; new users get the next free one from here.
FREEPBX_EXT_RANGE_START=3000

# ---------------------------------------------------------------------------
# FreePBX — WebRTC endpoint settings (direct MySQL)
# ---------------------------------------------------------------------------
# The Core GraphQL schema has no WebRTC inputs (AVPF, ICE, RTCP mux, DTLS-SRTP),
# so after creating an extension the backend writes them straight into the
# FreePBX `asterisk.sip` table over the private network, then calls doreload.
# Use a dedicated DB user granted only SELECT/INSERT/UPDATE on asterisk.sip,
# and firewall 3306 to this backend's IP. Setup: docs/freepbx-webrtc-setup.md
# REQUIRED: user creation fails if HOST/USER/PASSWORD are unset.
FREEPBX_DB_HOST=10.0.0.10
FREEPBX_DB_USER=omni_webrtc
FREEPBX_DB_PASSWORD=
# Defaults shown.
# FREEPBX_DB_PORT=3306
# FREEPBX_DB_NAME=asterisk

# ---------------------------------------------------------------------------
# FreePBX — admin web UI login
# ---------------------------------------------------------------------------
# Used for operations the GraphQL API does not expose (form login to the
# admin UI). Use a dedicated admin account, not your personal one.
FREEPBX_USERNAME=
FREEPBX_PASSWORD=

# ---------------------------------------------------------------------------
# FreePBX — softphone config handed to the browser
# ---------------------------------------------------------------------------
# SIP realm returned in sip-config; must match the FreePBX registration domain.
FREEPBX_SIP_DOMAIN=pbx.example.com
# WSS endpoint the WebRTC softphone connects to (Asterisk HTTP/WS, usually :8089).
FREEPBX_SIP_WS_SERVERS=wss://pbx.example.com:8089/ws

# ChanSpy call-monitoring feature codes. Verify against your PBX's
# Admin -> Feature Codes; these are FreePBX's defaults.
FREEPBX_FEATURECODE_SPY=555
FREEPBX_FEATURECODE_WHISPER=556
FREEPBX_FEATURECODE_BARGE=557

# ---------------------------------------------------------------------------
# Bot / AI auto-reply (optional)
# ---------------------------------------------------------------------------
# Chatwoot webhook forwarding target for bot handling.
BOT_WEBHOOK_URL=
# Token for the Chatwoot agent-bot that posts replies.
BOT_CHAT_TOKEN=
# Which LLM answers: none | openai | anthropic | gemini. Defaults to "none".
AI_PROVIDER=none
# Minimum confidence (0-1) before the bot replies instead of handing off.
BOT_CONFIDENCE_THRESHOLD=0.7

# Only the provider selected above needs its key. Model vars are optional and
# fall back to the defaults in src/services/bot.js.
OPENAI_API_KEY=
# OPENAI_MODEL=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
GEMINI_API_KEY=
# GEMINI_MODEL=
